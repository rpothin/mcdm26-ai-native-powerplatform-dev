# -------------------------------
# Code app build and local config
# -------------------------------
code-apps/*/dist/
code-apps/*/node_modules/
code-apps/*/.env*
!code-apps/*/.env.example

# -------------------------------
# Dataverse plugin local connection config
# -------------------------------
/.env

# -------------------------------
# Solution pack artifacts
# -------------------------------
/dist/
/*.zip
/solutions/**/*.zip

# -------------------------------
# PAC CLI generated outputs
# -------------------------------
*.msapp
pac-log-*.txt
pac-*.log

# -------------------------------
# Node.js standard patterns
# -------------------------------
node_modules/
npm-debug.log*
*.log

# -------------------------------
# OS and editor noise
# -------------------------------
.DS_Store
Thumbs.db
.vscode/settings.json

# -------------------------------
# Playwright test artifacts
# -------------------------------
playwright-report/
blob-report/
test-results/
code-apps/*/playwright-report/
code-apps/*/blob-report/
code-apps/*/test-results/

.claude/mcp_settings.json
.token_cache.bin
*.snk
__pycache__/
*.pyc
solutions/*.zip
plugins/**/bin/
plugins/**/obj/

# -------------------------------
# Impeccable design hook — machine-local overrides and dedup cache
# (config.json is shared/committed; config.local.json and the hook cache
# are per-developer, per skills-authoring/impeccable/reference/hooks.md)
# -------------------------------
.impeccable/config.local.json
.impeccable/hook.cache.json
code-apps/*/.impeccable/config.local.json
code-apps/*/.impeccable/hook.cache.json

